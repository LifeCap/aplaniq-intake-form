# Configure these in Netlify: Project configuration > Environment variables.
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_USER=your-sending-mailbox@aplaniq.co
SMTP_PASSWORD=replace-with-your-spacemail-mailbox-password
SMTP_FROM="APLANIQ Intake <your-sending-mailbox@aplaniq.co>"
INTAKE_RECIPIENT=hello@aplaniq.co

# Google Drive OAuth account that owns intake folders.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=replace-with-one-time-oauth-refresh-token
GOOGLE_DRIVE_PARENT_FOLDER_ID=replace-with-aplaniq-intakes-folder-id
